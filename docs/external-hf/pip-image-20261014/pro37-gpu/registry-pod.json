{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "name": "o5-pip-registry-20261014",
    "namespace": "eval",
    "labels": {
      "owner": "weihongliang",
      "task": "o5-pip-gpu-20261014",
      "app": "o5-readonly-registry"
    }
  },
  "spec": {
    "nodeSelector": {
      "kubernetes.io/hostname": "10.20.1.37"
    },
    "tolerations": [
      {
        "key": "lis.modelbest.co/reserved-for",
        "operator": "Equal",
        "value": "kaiqi-eval",
        "effect": "NoSchedule"
      }
    ],
    "restartPolicy": "Never",
    "automountServiceAccountToken": false,
    "hostNetwork": true,
    "terminationGracePeriodSeconds": 30,
    "containers": [
      {
        "name": "registry",
        "image": "moby/buildkit@sha256:f4f5220ec5e56f4d63d81cb73086c85a8cdb0195b355e53a9667c90bdc5443ea",
        "imagePullPolicy": "IfNotPresent",
        "command": [
          "/registry/readonly-registry",
          "18537"
        ],
        "securityContext": {
          "runAsUser": 1000,
          "runAsGroup": 1000,
          "allowPrivilegeEscalation": false,
          "readOnlyRootFilesystem": true,
          "capabilities": {
            "drop": [
              "ALL"
            ]
          }
        },
        "resources": {
          "requests": {
            "cpu": "100m",
            "memory": "32Mi"
          },
          "limits": {
            "cpu": "2",
            "memory": "256Mi"
          }
        },
        "volumeMounts": [
          {
            "name": "registry",
            "mountPath": "/registry",
            "readOnly": true
          }
        ]
      }
    ],
    "volumes": [
      {
        "name": "registry",
        "hostPath": {
          "path": "/data/weihongliang/o5-pip-image-20261014/registry",
          "type": "Directory"
        }
      }
    ]
  }
}
