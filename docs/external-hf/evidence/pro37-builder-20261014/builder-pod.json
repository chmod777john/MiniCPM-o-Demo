{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "name": "o5-pip-buildkit-20261014",
    "namespace": "eval",
    "labels": {
      "app": "o5-pip-buildkit",
      "owner": "weihongliang",
      "task": "o5-pip-install-20261014"
    }
  },
  "spec": {
    "restartPolicy": "Never",
    "automountServiceAccountToken": false,
    "nodeSelector": {
      "kubernetes.io/hostname": "10.20.1.37"
    },
    "tolerations": [
      {
        "key": "lis.modelbest.co/reserved-for",
        "operator": "Equal",
        "value": "kaiqi-eval",
        "effect": "NoSchedule"
      }
    ],
    "initContainers": [
      {
        "name": "prepare-task-dir",
        "image": "moby/buildkit@sha256:f4f5220ec5e56f4d63d81cb73086c85a8cdb0195b355e53a9667c90bdc5443ea",
        "command": [
          "sh",
          "-ec",
          "mkdir -p /work/cache /work/context /work/output; chown 1000:1000 /work /work/cache /work/context /work/output"
        ],
        "securityContext": {
          "runAsUser": 0,
          "runAsGroup": 0,
          "allowPrivilegeEscalation": false
        },
        "resources": {
          "requests": {
            "cpu": "100m",
            "memory": "32Mi"
          },
          "limits": {
            "cpu": "1",
            "memory": "128Mi"
          }
        },
        "volumeMounts": [
          {
            "name": "task-data",
            "mountPath": "/work"
          }
        ]
      }
    ],
    "containers": [
      {
        "name": "buildkit",
        "image": "moby/buildkit@sha256:f4f5220ec5e56f4d63d81cb73086c85a8cdb0195b355e53a9667c90bdc5443ea",
        "args": [
          "--addr",
          "unix:///run/user/1000/buildkit/buildkitd.sock",
          "--root",
          "/work/cache",
          "--oci-worker-snapshotter=native",
          "--oci-worker-no-process-sandbox"
        ],
        "securityContext": {
          "runAsUser": 1000,
          "runAsGroup": 1000,
          "seccompProfile": {
            "type": "Unconfined"
          },
          "appArmorProfile": {
            "type": "Unconfined"
          }
        },
        "resources": {
          "requests": {
            "cpu": "1",
            "memory": "1Gi"
          },
          "limits": {
            "cpu": "4",
            "memory": "16Gi"
          }
        },
        "env": [
          {
            "name": "BUILDKIT_HOST",
            "value": "unix:///run/user/1000/buildkit/buildkitd.sock"
          }
        ],
        "volumeMounts": [
          {
            "name": "task-data",
            "mountPath": "/work"
          }
        ]
      }
    ],
    "volumes": [
      {
        "name": "task-data",
        "hostPath": {
          "path": "/data/weihongliang/o5-pip-image-20261014",
          "type": "DirectoryOrCreate"
        }
      }
    ]
  }
}
