# syntax=docker/dockerfile:1
#
# O5 realtime Gateway image (torch-free).
#
# The Gateway exposes WebSocket API routes, discovers models, schedules Workers
# and relays protocol frames. It does not build or serve frontend pages/docs;
# those belong to the separate application image.
#
# Runtime dependencies: fastapi/uvicorn/httpx/websockets/pydantic.
# 整个 runtime/ 已确认 torch-free,可安全打进轻镜像。
#
# 模型权重、torch 都不在本镜像——那是 worker-backend 镜像的事。
# Application data and session recording live in the separate application image.
#
FROM python:3.12-slim-bookworm

ENV PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONPATH=/app

# 轻量系统依赖:curl 仅用于健康检查
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# gateway 的全部 Python 依赖(无 torch / transformers / minicpmo-utils)
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install \
        "fastapi>=0.128.0" \
        "uvicorn>=0.40.0" \
        "httpx>=0.28.0" \
        "websockets>=16.0" \
        "pydantic>=2.11.0"

# 代码放最后(最常变,前面依赖层全命中缓存)
COPY . .

EXPOSE 8006 8007

# gateway 启动参数由 compose command 提供(--port / --internal-port / --https|--http)
ENTRYPOINT ["python", "gateway.py"]
