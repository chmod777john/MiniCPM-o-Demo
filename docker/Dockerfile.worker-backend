# syntax=docker/dockerfile:1
#
# worker + backend bundle 镜像（新链路）。
#
# 一个容器内同时跑：
#   - py_backend.server   （协议服务端，加载模型，独占 1 GPU）
#   - worker.py           （纯转发隔离层，--backend-server-url 指向 localhost backend）
# gateway 不在本镜像内（它 torch-free，单独进程跑）。
#
# base 用普通 python，不用 nvidia/cuda 镜像：torch 的 +cu128 wheel 自带 CUDA 用户态库
#（libcudart/cudnn/cublas/nccl 等），driver 由宿主机 nvidia runtime 注入。
#
# 模型权重不进镜像（19G），运行时以 volume 挂载，见 entrypoint。

FROM python:3.12-slim-bookworm

ENV PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONPATH=/app \
    O5_DEPLOY_MODE=tp2 \
    O5_ATTN_IMPLEMENTATION=auto \
    O5_EXPERTS_IMPLEMENTATION=batched_mm \
    O5_LLM_GRAPH=1 \
    O5_TTS_FAST=1 \
    O5_LMHEAD=1 \
    O5_TTS_GRAPH=1 \
    O5_VOCODER_GRAPH=0 \
    O5_FUSE_VISION_AUDIO=1 \
    O5_VISION_BATCH=1 \
    O5_UNIT_PREFILL_BATCH=1 \
    O5_LLM_CACHE=32768 \
    LD_LIBRARY_PATH=/usr/local/lib/python3.12/site-packages/nvidia/npp/lib:/usr/local/cuda/lib64:/usr/local/nvidia/lib64:/usr/local/nvidia/lib \
    TORCHINDUCTOR_CACHE_DIR=/app/torch_compile_cache

# ---- 系统依赖（很少变，放最上层）----
# ffmpeg: 音视频解码（media.py / moviepy / decord 运行期需要）
# libsndfile1: soundfile 读写音频
# curl: entrypoint 健康检查
RUN apt-get update && apt-get install -y --no-install-recommends \
        ffmpeg \
        libsndfile1 \
        curl \
        gcc \
        libc6-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# ---- ① high-cu128 runtime：完整依赖声明单独一层，requirements 变才重跑 ----
# Torch 2.11 + cu128 是 grouped_mm / 当前 FLA runtime 使用的版本。
# minicpmo-utils 只以 --no-deps 安装，避免其旧 metadata 把 transformers 降到 4.x。
COPY requirements-high-cu128.txt .
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --no-deps "minicpmo-utils==1.0.6" \
    && pip install -r requirements-high-cu128.txt

# ---- ② 代码放最后：最常变，但只影响这一层；依赖层可复用 ----
COPY . .

RUN chmod +x docker/entrypoint-worker-backend.sh \
    && mkdir -p /app/data /app/tmp /app/torch_compile_cache

# backend 协议端口（容器内 worker 走 localhost 连它，不必对外暴露）
EXPOSE 22500
# worker 转发端口（gateway 连这个）
EXPOSE 22400

ENTRYPOINT ["docker/entrypoint-worker-backend.sh"]
