# Copy to .env.local; restart npm run dev after changing these values.
# Existing Demo Gallery serves FC presets, reference audio and scene tools.
PLAYGROUND_GALLERY_TARGET=http://127.0.0.1:10032
# Optional: original single-turn / ordinary-duplex application service.
# PLAYGROUND_PRESET_TARGET=http://127.0.0.1:9000
# Only for a trusted development upstream with a self-signed certificate.
# Applies to the configured application proxies; browser inference stays direct.
# PLAYGROUND_PROXY_TLS_INSECURE=1
