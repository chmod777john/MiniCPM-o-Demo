# Copy to .env.local; restart npm run dev after changing these values.
# Application service: model endpoint catalog, FC presets, reference audio and scene tools.
PLAYGROUND_GALLERY_TARGET=http://127.0.0.1:10032
# Optional: independent UI Card application with deployment-owned search/weather/map credentials.
# PLAYGROUND_UICARD_TARGET=http://127.0.0.1:5188
# Optional: browser-direct default model endpoint for this deployment.
# Changing it resets saved connection addresses once; other user settings remain.
# VITE_PLAYGROUND_DEFAULT_API=https://api.example.com/e/default
# Optional: service that stores session recordings and serves share links.
# PLAYGROUND_SESSION_TARGET=http://127.0.0.1:9000
# Optional: override conversation presets/schema or the bundled reference-audio directory.
# PLAYGROUND_CASES_FILE=/path/to/cases.json
# PLAYGROUND_AUDIO_ROOT=/path/to/reference-audio
# Only for trusted development application proxies with a self-signed certificate.
# Browser inference stays direct and uses the browser's TLS validation.
# PLAYGROUND_PROXY_TLS_INSECURE=1
