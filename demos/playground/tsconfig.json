{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["vite/client", "node"]
  },
  "include": [
    "app",
    "shared",
    "turnbased",
    "audio-duplex",
    "video-duplex",
    "board",
    "uicard",
    "subagent",
    "rejection",
    "standalone",
    "vite.config.ts",
    "server"
  ]
}
